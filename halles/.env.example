# =============================================================================
# Halles — variables d'environnement
# =============================================================================
# Copier ce fichier en .env.local et renseigner les valeurs.
# Aucune de ces valeurs ne doit être commitée.

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service : contourne la RLS. Serveur uniquement, jamais exposée au
# navigateur, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Domaine ------------------------------------------------------------------
# Domaine racine sans protocole ni port. En développement : localhost
# En production : halles.app  (les guides vivent sur {slug}.halles.app)
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# --- Cartographie -------------------------------------------------------------
# URL du fichier .pmtiles auto-hébergé (Supabase Storage ou R2).
# Aucune facturation à la vue, contrairement à Mapbox ou Google Maps.
NEXT_PUBLIC_PMTILES_URL=

# --- Courriel (phase 4 : suggestions d'adresses des hôteliers) ----------------
RESEND_API_KEY=

# --- Crons (phase 6) ----------------------------------------------------------
# Secret partagé vérifié par les routes /api/cron/* appelées par Vercel Cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=
